# Pick ONE provider. "mock" runs offline with no key.
LLM_PROVIDER=gemini
# Model names change: copy the current one from the provider's model list (e.g. a Flash model in Google AI Studio).
MODEL=

# Keys (only the one you use)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# USD per million tokens, from the provider's pricing page. Leave 0 on a free tier.
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
